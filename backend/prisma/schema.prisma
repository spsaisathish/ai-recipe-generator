generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model recipe_embeddings {
  id         Int                    @id @default(autoincrement())
  content    String
  embedding  Unsupported("vector")?
  created_at DateTime?              @default(now()) @db.Timestamp(6)
}
